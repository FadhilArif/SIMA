# Supabase Edge Functions local/production secrets
# JANGAN commit nilai asli.

# Google Drive API — semua PDF/foto SIMA disimpan di Google Drive.
# Nilai asli hanya di Supabase Edge Function secrets.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Opsional: email akun Workspace untuk Domain-Wide Delegation.
GOOGLE_SUBJECT=

SMTP_HOSTNAME=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
